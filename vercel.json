{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "comment": "Every route is client-side. Without this, /c/soil 404s on a hard load or a shared link.",
      "source": "/((?!assets/|scenes/|textures/|photos/|favicon|resume).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(assets|scenes|textures)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
